   "source": [
    "def extract_beats_from_r(ecg, r_peaks, fs, post_ms=400):\n",
    "    post_samples = int(125)\n",
    "    #post_samples = int((post_ms / 1000.0) * fs)\n",
    "    beats = []\n",
    "\n",
    "    for r in r_peaks:\n",
    "        end = r + post_samples\n",
    "        if end <= len(ecg):\n",
    "            beat = ecg[r:end]\n",
    "            beats.append(beat)\n",
    "\n",
    "    return np.array(beats)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 10,
   "metadata": {},
   "outputs": [],
