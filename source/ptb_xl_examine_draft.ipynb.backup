    "device = torch.device(\"cuda\" if torch.cuda.is_available() else \"cpu\")\n",
    "model = CNN().to(device)\n",
    "model.load_state_dict(torch.load('../train_models/models_save/CNN_model.pth'))\n",
    "model.eval()"
   ]
