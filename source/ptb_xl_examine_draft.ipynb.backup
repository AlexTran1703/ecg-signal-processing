   "source": [
    "def save_data(data, path=\"exg.txt\"):\n",
    "    array=data\n",
    "    norm = (array - array.min()) / (array.max() - array.min())\n",
    "    scaled = (norm * 65535).astype(np.uint16)\n",
    "    scaled = np.round(scaled).astype(np.uint16)\n",
    "    np.savetxt(path, scaled, fmt=\"%d\")\n",
    "    plt.plot(scaled)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 18,
